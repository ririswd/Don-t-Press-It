{
  "name": "dont-press-it",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "workspaces": [
    "contracts",
    "frontend"
  ],
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint",
    "typecheck": "pnpm --filter frontend typecheck",
    "test": "pnpm contracts:test:game && pnpm --filter frontend test",
    "check": "pnpm contracts:compile && pnpm contracts:test:game && pnpm lint && pnpm typecheck && pnpm --filter frontend test && pnpm build",
    "contracts:compile": "pnpm --filter contracts compile",
    "contracts:test": "pnpm --filter contracts test",
    "contracts:test:game": "pnpm --filter contracts test:game",
    "contracts:coverage": "pnpm --filter contracts test:coverage",
    "contracts:deploy:game:local": "pnpm --filter contracts deploy:game:local",
    "contracts:deploy:game:testnet": "pnpm --filter contracts deploy:game:testnet",
    "contracts:deploy:game:mainnet": "pnpm --filter contracts deploy:game:mainnet",
    "contracts:node": "pnpm --filter contracts node"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "forge-std": "github:foundry-rs/forge-std#2f05b3001ed9d74b171d17eac80b3765ce186a76",
    "ds-test": "github:dapphub/ds-test#e282159d5170298eb2455a6c05280ab5a73a4ef0",
    "@safe-global/safe-smart-account": "github:safe-global/safe-smart-account#dc437e8fba8b4805d76bcbd1c668c9fd3d1e83be"
  },
  "resolutions": {
    "forge-std": "github:foundry-rs/forge-std#2f05b3001ed9d74b171d17eac80b3765ce186a76",
    "ds-test": "github:dapphub/ds-test#e282159d5170298eb2455a6c05280ab5a73a4ef0",
    "@safe-global/safe-smart-account": "github:safe-global/safe-smart-account#dc437e8fba8b4805d76bcbd1c668c9fd3d1e83be"
  }
}
